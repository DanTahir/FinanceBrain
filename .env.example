# Copy to .env (gitignored). The OpenRouter key is read from Openrouterkey.txt or OPENROUTER_API_KEY.
# 127.0.0.1 rather than localhost: on Windows, localhost tries IPv6 ::1 first and adds ~2 s per new connection
FB_FALKORDB_HOST=127.0.0.1
FB_FALKORDB_PORT=6379
FB_FALKORDB_PASSWORD=devpassword
FB_ENV=dev
